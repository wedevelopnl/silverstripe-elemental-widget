{
    "name": "wedevelopnl/silverstripe-elemental-widget",
    "description": "Re-usable widgets for silverstripe-elemental",
    "keywords": [
        "widget",
        "silverstripe",
        "elemental"
    ],
    "repositories": [{
        "type": "vcs",
        "url": "https://github.com/wedevelopnl/silverstripe-elemental"
    }],
    "type": "silverstripe-vendormodule",
    "require": {
        "php": ">=8.1",
        "silverstripe/framework": "^5.2",
        "silverstripe/cms": "^5",
        "dnadesign/silverstripe-elemental": "dev-5.2-for-ss-5.4",
        "sheadawson/silverstripe-dependentdropdownfield": "^2",
        "unclecheese/display-logic": "^2.0",
        "silverstripe/framework": "^5.0",
        "silverstripe/cms": "^5.0",
        "sheadawson/silverstripe-dependentdropdownfield": "^2 || ^3",
        "unclecheese/display-logic": "^2.0 || ^3.0",
        "stevie-mayhew/hasoneedit": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "WeDevelop\\ElementalWidget\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": false,
            "silverstripe/vendor-plugin": false
        }
    }
}
